# Copia este archivo como .env (nunca subas el .env a GitHub).
# Todo es opcional: sin .env la app funciona "solo en este equipo".

# Nombre por defecto del negocio (cada dueño lo cambia en el primer inicio)
VITE_BUSINESS_NAME=Minimarket Don Pepe

# Respaldo en línea y uso en varios equipos (Supabase). Ver README, sección 3.
# La "publishable key" es pública por diseño: lo que protege los datos son las
# reglas RLS de supabase/schema.sql. NUNCA pongas aquí la "secret key".
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Nota: ya no existe una clave de caja por defecto. Cada dueño crea la suya
# la primera vez que abre la app (se guarda cifrada con PBKDF2).
