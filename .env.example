# Contraseña máster inicial (si no se define, es 1234).
# Se puede cambiar después desde Ajustes dentro de la app.
VITE_MASTER_PASSWORD=1234

# Nombre del negocio que aparece en el login y en la barra superior
VITE_BUSINESS_NAME=Minimarket Don Pepe

# Sincronización entre dispositivos y respaldo en línea (opcional).
# Sin estas dos líneas la app funciona "solo en este dispositivo".
# Se obtienen en Supabase → Project Settings → API Keys (ver README).
# La "publishable key" es pública por diseño: la seguridad la dan las
# políticas RLS de supabase/schema.sql.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
